<html>

<head>
    <title>Cleats</title>
    <link href="/style.css" rel="stylesheet">
    <link rel="icon" type="image/png" href="images/frisbee_Icon.png" />

</head>

<body>
    {%include "partial-nav.njk" %}

    <div class="product-main-container">

        <div class="product-image-group">
            <img class="product-image" src="{{ product.image }}" alt="{{ product.name }}">
        </div>

        <div class="product-text-group">
            <h1>{{ product.name }}</h1>
            <p>{{ product.brand }}</p>
            <p>${{ product.price }}</p>
            <p>{{ product.description }}</p>
        </div>


    </div>
    <section class="experiences">
        <h1>Experiences</h1>

        {% for entry in experiences %}
        <div class="experience-comment">
            <h3>{{ entry.user }}</h3>
            <p>{{ entry.experience }}</p>
        </div>
        {% else %}
        <p>No experiences yet. Be the first to share one!</p>
        {% endfor %}


        <a href="/add-your-experience" class="button">Add your experience</a>
    </section>
</body>

</html>