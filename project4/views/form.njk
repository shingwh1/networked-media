<html>

<head>
    <title>ferris wheel passengers</title>
    <link href="style.css" rel="stylesheet">
</head>

<body>
    <section class="left"></section>
    <form method="POST" action="/add-data">
        <input type="text" name="passengerName" placeholder="add a name" required>
        {# we can add more input fields if we want to #}
        <input type="text" name="thought" placeholder="what are they thinking?" required>
        <input type="text" name="mood" placeholder="what are they feeling?" required>
        <input type="text" name="weather" placeholder="how was the weather" required>

        <input type="submit" value="send data">
    </form>
    <section class="right"></section>
</body>

</html>